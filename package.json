{
  "name": "calisthenics-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run verify && npm run verify:session && npm run verify:nutrition && npm run lint && npm run build",
